module ps2 (
    input  logic       PS2_KBCLK,
    input  logic       PS2_KBDAT,
    input  logic       rst_n,
    input  logic       computerClk,
    output logic [15:0] hexo
);
    // Estados
    typedef enum logic [1:0] {
        WAITING_FOR_START = 2'd0,
        SENDING_DATA      = 2'd1,
        END_PROCESSING    = 2'd2
    } state_t;
    
    state_t state_reg, state_next;
    
    logic PS2_KBCLK_DEB;
    logic parity_reg, parity_next;
    logic [3:0] n_reg, n_next;
    logic [8:0] data_reg, data_next;
    logic [15:0] bin_code_reg, bin_code_next;
    logic [15:0] display_bin_code_reg, display_bin_code_next;
    logic counter_reg, counter_next;
    
    // Debouncer para el reloj PS/2
    deb deb0 (
        .clk(computerClk),
        .rst_n(rst_n),
        .in(PS2_KBCLK),
        .out(PS2_KBCLK_DEB)
    );
    
    assign hexo = display_bin_code_reg;
    
    // Registros síncronos
    always_ff @(posedge computerClk or negedge rst_n) begin
        if (!rst_n) begin
            state_reg            <= WAITING_FOR_START;
            n_reg                <= 4'd0;
            data_reg             <= 9'd0;
            parity_reg           <= 1'd0;
            bin_code_reg         <= 16'd0;
            counter_reg          <= 1'd0;
            display_bin_code_reg <= 16'h0000;
        end
        else begin
            state_reg            <= state_next;
            n_reg                <= n_next;
            data_reg             <= data_next;
            parity_reg           <= parity_next;
            bin_code_reg         <= bin_code_next;
            counter_reg          <= counter_next;
            display_bin_code_reg <= display_bin_code_next;
        end
    end
    
    // Máquina de estados en flanco negativo del reloj PS/2
    always_ff @(negedge PS2_KBCLK_DEB or negedge rst_n) begin
        if (!rst_n) begin
            state_next            = WAITING_FOR_START;
            n_next                = 4'd0;
            data_next             = 9'd0;
            parity_next           = 1'd0;
            bin_code_next         = 16'd0;
            counter_next          = 1'd0;
            display_bin_code_next = 16'h0000;
        end
        else begin
            
            state_next            = state_reg;
            n_next                = n_reg;
            data_next             = data_reg;
            parity_next           = parity_reg;
            bin_code_next         = bin_code_reg;
            counter_next          = counter_reg;
            display_bin_code_next = display_bin_code_reg;
            
            case (state_reg)
                WAITING_FOR_START: begin
                    if (PS2_KBDAT == 1'b0) begin  // Bit de START
                        n_next     = 4'd9;
                        data_next  = 9'd0;
                        state_next = SENDING_DATA;
                        if (data_reg[7:0] != 8'hE0 && data_reg[7:0] != 8'hF0) begin
                            bin_code_next = 16'd0;
                        end
                    end
                end
                
                SENDING_DATA: begin
                    if (n_reg == 4'd9) begin
                        parity_next = PS2_KBDAT;
                    end
                    else begin
                        parity_next = parity_reg ^ PS2_KBDAT;
                    end
                    
                    data_next = {PS2_KBDAT, data_reg[8:1]};
                    
                    if (n_reg == 4'd1) begin
                        state_next = END_PROCESSING;
                    end
                    else begin
                        n_next = n_reg - 4'd1;
                    end
                end
                
                END_PROCESSING: begin
                    if (PS2_KBDAT == 1'b1) begin  // Bit de STOP
                        if (parity_reg) begin
                            bin_code_next = {bin_code_reg[7:0], data_reg[7:0]};
                            
                            if (counter_reg == 1'b0 || 
                                data_reg[7:0] == 8'hE0 || 
                                data_reg[7:0] == 8'hF0) begin
                                counter_next = 1'b1;
                            end
                            else begin
                                display_bin_code_next = bin_code_next;
                                counter_next = 1'b0;
                            end
                        end
                        else begin
                            // Error de paridad
                            display_bin_code_next = 16'hFFFF;
                        end
                        state_next = WAITING_FOR_START;
                    end
                end
                
                default: state_next = WAITING_FOR_START;
            endcase
        end
    end
endmodule