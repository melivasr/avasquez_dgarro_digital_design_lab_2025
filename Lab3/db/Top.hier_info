|time_counter
clk => timer_flag~reg0.CLK
clk => seconds[0]~reg0.CLK
clk => seconds[1]~reg0.CLK
clk => seconds[2]~reg0.CLK
reset => timer_flag~reg0.ACLR
reset => seconds[0]~reg0.ACLR
reset => seconds[1]~reg0.ACLR
reset => seconds[2]~reg0.ACLR
tick => timer_flag.OUTPUTSELECT
tick => seconds.OUTPUTSELECT
tick => seconds.OUTPUTSELECT
tick => seconds.OUTPUTSELECT
start => seconds.OUTPUTSELECT
start => seconds.OUTPUTSELECT
start => seconds.OUTPUTSELECT
start => timer_flag.OUTPUTSELECT
timer[0] => seconds.DATAB
timer[1] => seconds.DATAB
timer[2] => seconds.DATAB
timer_flag <= timer_flag~reg0.DB_MAX_OUTPUT_PORT_TYPE
seconds[0] <= seconds[0]~reg0.DB_MAX_OUTPUT_PORT_TYPE
seconds[1] <= seconds[1]~reg0.DB_MAX_OUTPUT_PORT_TYPE
seconds[2] <= seconds[2]~reg0.DB_MAX_OUTPUT_PORT_TYPE


